{
  "$description": "Trellis token source, in the W3C Design Tokens format. One seed for every platform: lengths are in cells or in points, never in rem or px. A point is one CSS pixel at the reader's default text size, one pt on iOS, one dp on Android. tools/build-tokens.js writes the generated tokens of core.css from this file, and does the rem conversion for the web. Formulas (the fit, the ratio, the gutter) are not values and are not here: see math.js.",

  "cell": {
    "$description": "The cell, the measure of space. Its target grows in a straight line from the narrow screen to the wide one, then holds, and it follows the reader's text size.",
    "$type": "number",
    "$extensions": { "trellis": { "unit": "pt" } },
    "target-narrow": { "$value": 10, "$description": "The cell on a narrow screen." },
    "target-wide": { "$value": 12, "$description": "The cell on a wide screen." },
    "screen-narrow": { "$value": 500, "$description": "Up to this width the cell is target-narrow." },
    "screen-wide": { "$value": 1000, "$description": "From this width the cell is target-wide." }
  },

  "frame": {
    "$description": "The page's outer box, in cells.",
    "$type": "number",
    "$extensions": { "trellis": { "unit": "cell" } },
    "max": { "$value": 100, "$description": "The widest the frame gets." }
  },

  "space": {
    "$description": "The octaves: the cell halved and doubled. Between blocks, space is whole cells; halves and quarters live inside things.",
    "$type": "number",
    "$extensions": { "trellis": { "unit": "cell" } },
    "q": { "$value": 0.25, "$description": "A quarter cell, rounded to a whole pixel and never less than a line." },
    "h": { "$value": 0.5 },
    "1": { "$value": 1 },
    "1h": { "$value": 1.5 },
    "2": { "$value": 2 },
    "3": { "$value": 3 },
    "4": { "$value": 4 },
    "6": { "$value": 6 },
    "8": { "$value": 8 },
    "12": { "$value": 12 },
    "16": { "$value": 16 }
  },

  "size": {
    "$description": "Named sizes, each an octave or an octave plus a line.",
    "icon": {
      "$type": "number",
      "$extensions": { "trellis": { "unit": "cell" } },
      "sm": { "$value": 1 },
      "base": { "$value": 1, "$description": "One cell plus a line each side.", "$extensions": { "trellis": { "unit": "cell", "lines": 2 } } },
      "md": { "$value": 1.5 },
      "lg": { "$value": 2 }
    },
    "control": {
      "$description": "Control heights.",
      "$type": "number",
      "$extensions": { "trellis": { "unit": "cell" } },
      "xs": { "$value": 1.5 },
      "sm": { "$value": 2 },
      "md": { "$value": 2.5 },
      "lg": { "$value": 3 },
      "xl": { "$value": 4 }
    },
    "hit-min": { "$type": "number", "$value": 44, "$description": "The least hit area on a coarse pointer, whatever a control draws. A platform layer turns this: 44 on iOS, 48 on Android.", "$extensions": { "trellis": { "unit": "pt" } } }
  },

  "control-type": {
    "$description": "Control labels: fixed sizes, not fluid. The only font sizes outside the type roles.",
    "$type": "number",
    "$extensions": { "trellis": { "unit": "pt" } },
    "xs": { "$value": 11 },
    "sm": { "$value": 12 },
    "md": { "$value": 13 },
    "base": { "$value": 14 },
    "lg": { "$value": 16 }
  },

  "radius": {
    "$description": "Corners are octaves too. A nested corner is the outer corner less the padding.",
    "$type": "number",
    "$extensions": { "trellis": { "unit": "cell" } },
    "q": { "$value": 0.25 },
    "h": { "$value": 0.5 },
    "1": { "$value": 1 },
    "1h": { "$value": 1.5 },
    "2": { "$value": 2 },
    "round": { "$value": 999, "$description": "A full pill.", "$extensions": { "trellis": { "unit": "pt" } } }
  },

  "layer": {
    "$description": "One scale for everything that stacks.",
    "$type": "number",
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 1000 },
    "float": { "$value": 1100 },
    "toast": { "$value": 1200 }
  },

  "motion": {
    "duration": {
      "$description": "Enter slower than exit.",
      "$type": "duration",
      "out": { "$value": { "value": 150, "unit": "ms" } },
      "in": { "$value": { "value": 200, "unit": "ms" } },
      "in-slow": { "$value": { "value": 250, "unit": "ms" } },
      "sheet-in": { "$value": { "value": 350, "unit": "ms" } },
      "sheet-out": { "$value": { "value": 300, "unit": "ms" } },
      "skeleton": { "$value": { "value": 1400, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "in": { "$value": [0.4, 0, 1, 1] },
      "out": { "$value": [0, 0, 0.2, 1] },
      "spring": { "$value": [0.32, 0.72, 0, 1] }
    }
  },

  "type": {
    "$description": "The ratio's neutral defaults. Two anchors, H1 and body, each with a size in a narrow space and a wide one; headings step down from H1 by one ratio and paragraphs step out from body by another, and both ratios open with the space. A product layer turns all of these.",
    "$type": "number",
    "space-narrow": { "$value": 320, "$description": "The narrow container.", "$extensions": { "trellis": { "unit": "pt" } } },
    "space-wide": { "$value": 1440, "$description": "The wide container.", "$extensions": { "trellis": { "unit": "pt" } } },
    "h1-narrow": { "$value": 36, "$extensions": { "trellis": { "unit": "pt" } } },
    "h1-wide": { "$value": 64, "$extensions": { "trellis": { "unit": "pt" } } },
    "body-narrow": { "$value": 16, "$extensions": { "trellis": { "unit": "pt" } } },
    "body-wide": { "$value": 18, "$extensions": { "trellis": { "unit": "pt" } } },
    "label-narrow": { "$value": 11, "$extensions": { "trellis": { "unit": "pt" } } },
    "label-wide": { "$value": 12, "$extensions": { "trellis": { "unit": "pt" } } },
    "heading-ratio-narrow": { "$value": 1.2 },
    "heading-ratio-wide": { "$value": 1.333 },
    "paragraph-ratio-narrow": { "$value": 1.125 },
    "paragraph-ratio-wide": { "$value": 1.2 }
  },

  "color": {
    "$description": "Semantic roles, each a light and dark pair. These are the neutral defaults; a product layer turns them.",
    "$type": "color",
    "bg": { "light": { "$value": "#f6f6f4" }, "dark": { "$value": "#101111" }, "$description": "The page." },
    "bg-raised": { "light": { "$value": "#ffffff" }, "dark": { "$value": "#18191a" }, "$description": "Cards, floats, inputs." },
    "bg-sunken": { "light": { "$value": "#ececea" }, "dark": { "$value": "#0a0b0b" }, "$description": "Code, bands, disabled." },
    "bg-hover": { "light": { "$value": "#eaeae7" }, "dark": { "$value": "#242526" }, "$description": "Hover and selected." },
    "text": { "light": { "$value": "#18191a" }, "dark": { "$value": "#f4f4f2" }, "$description": "Primary ink." },
    "text-secondary": { "light": { "$value": "#45474a" }, "dark": { "$value": "#c4c5c6" }, "$description": "Supporting ink." },
    "text-tertiary": { "light": { "$value": "#6d7074" }, "dark": { "$value": "#8e9195" }, "$description": "Labels and metadata." },
    "text-faint": { "light": { "$value": "#9a9da1" }, "dark": { "$value": "#5f6266" }, "$description": "The quietest ink." },
    "border": { "light": { "$value": "#d6d7d8" }, "dark": { "$value": "#2e3032" }, "$description": "The default edge." },
    "border-subtle": { "light": { "$value": "#e4e5e6" }, "dark": { "$value": "#222425" }, "$description": "Cards, rules between rows." },
    "border-strong": { "light": { "$value": "#a9abae" }, "dark": { "$value": "#4a4d50" }, "$description": "Buttons, a quotation's line." },
    "accent": { "light": { "$value": "#2c6fd1" }, "dark": { "$value": "#6aa5f5" }, "$description": "The primary action." },
    "accent-ink": { "light": { "$value": "#ffffff" }, "dark": { "$value": "#ffffff" }, "$description": "Ink on the accent." },
    "focus": { "light": { "$value": "#2c6fd1" }, "dark": { "$value": "#6aa5f5" }, "$description": "The focus ring." }
  },

  "kind": {
    "$description": "What sort of thing this is. Shape and color both follow kind.",
    "$type": "color",
    "person": { "light": { "$value": "#b8740a" }, "dark": { "$value": "#f5a524" } },
    "group": { "light": { "$value": "#1f8394" }, "dark": { "$value": "#3db3c5" } },
    "event": { "light": { "$value": "#7e3e9c" }, "dark": { "$value": "#b77ad6" } },
    "course": { "light": { "$value": "#0b7d45" }, "dark": { "$value": "#2fb874" } },
    "topic": { "light": { "$value": "#1b62c0" }, "dark": { "$value": "#5b9cf0" }, "$description": "Also the default tag." }
  },

  "status": {
    "$type": "color",
    "ok": { "light": { "$value": "#0a8f4a" }, "dark": { "$value": "#2cc574" } },
    "warn": { "light": { "$value": "#a86a00" }, "dark": { "$value": "#f5a524" } },
    "alert": { "light": { "$value": "#c2441f" }, "dark": { "$value": "#ef6c44" } }
  }
}
